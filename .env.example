# =============================================================================
# SERVER INFOS
# =============================================================================
SERVER_IP=0.0.0.0

# =============================================================================
# API KEYS
# =============================================================================
NVD_API_KEY=your_nvd_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# =============================================================================
# DATABASE INFOS
# =============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=avea
DB_PASSWORD=devpassword
DB_NAME=asset_vuln_manager

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# --- Sauvegarde locale ---
LOCAL_BACKUP_DIR=backups

# --- Sauvegarde NAS (générique) ---
ENABLE_NAS_BACKUP=false
MAX_BACKUPS=5

# --- Protocole NAS (choisir UN SEUL parmis : smb, ssh, rsync, local) ---
NAS_PROTOCOL=smb

# --- Paramètres SMB (si NAS_PROTOCOL=smb) ---
NAS_SMB_SERVER=
NAS_SMB_SHARE=backup
NAS_SMB_USER=
NAS_SMB_PASSWORD=
NAS_SMB_DIR=AirGappedCVE
NAS_SMB_MOUNT=/mnt/nas_backup

# --- Paramètres SSH/SCP (si NAS_PROTOCOL=ssh) ---
NAS_SSH_SERVER=
NAS_SSH_USER=
NAS_SSH_PASSWORD=
NAS_SSH_PORT=22
NAS_SSH_DIR=/backup/AirGappedCVE

# --- Paramètres RSYNC (si NAS_PROTOCOL=rsync) ---
NAS_RSYNC_SERVER=
NAS_RSYNC_USER=
NAS_RSYNC_DIR=backup/AirGappedCVE

# --- Paramètres dossier local monté (si NAS_PROTOCOL=local) ---
NAS_LOCAL_MOUNT=/mnt/nas/backup/AirGappedCVE